{
  "name": "@obinexusltd/obix-runtime",
  "version": "0.2.1",
  "description": "The OBIX browser binding runtime. Text/attr/bool/aria/event binding helpers only. No business logic, no VDOM, no router, no store. Tree-shaken bundle <= 4 KB gzip. Zero dependencies.",
  "license": "MIT",
  "type": "module",
  "private": false,
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/obinexusmk2/obix-monorepo-2026.git",
    "directory": "packages/obix-runtime"
  }
}
