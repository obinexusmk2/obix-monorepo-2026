{
  "name": "obix-adapter-func",
  "version": "0.2.1",
  "description": "OBIX Functional projection — pure reduce / replay + a create() closure. All action execution routes through obix-ir.applyAction. Depends on obix-spec and obix-ir.",
  "license": "MIT",
  "type": "module",
  "private": false,
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "obix-spec": "0.2.1",
    "obix-ir": "0.2.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/obinexusmk2/obix-adapter-func.git",
    "directory": "packages/obix-adapter-func"
  }
}
