{
  "name": "obix-adapter-native",
  "version": "0.2.1",
  "description": "OBIX Native projection — the only adapter that touches the DOM. Mounts a component using the reactive projection + obix-runtime bindings. Depends on spec, ir, obix-adapter-reactive and obix-runtime.",
  "license": "MIT",
  "type": "module",
  "private": false,
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "obix-spec": "0.2.1",
    "obix-ir": "0.2.1",
    "obix-adapter-reactive": "0.2.1",
    "obix-runtime": "0.2.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/obinexusmk2/obix-monorepo-2026.git",
    "directory": "packages/obix-adapter-native"
  }
}
