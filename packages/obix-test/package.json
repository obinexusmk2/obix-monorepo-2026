{
  "name": "@obinexusltd/obix-test",
  "version": "0.2.1",
  "description": "OBIX adapter-equivalence orchestration + behavioural/contract DSL parsers. Compares every projection to the INDEPENDENT obix-validator.referenceFold oracle, step by step. Depends on spec, ir, validator and the four pure adapters.",
  "license": "MIT",
  "type": "module",
  "private": false,
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./equivalence": {
      "types": "./dist/equivalence/index.d.ts",
      "import": "./dist/equivalence/index.js"
    },
    "./behavioural": {
      "types": "./dist/behavioural/index.d.ts",
      "import": "./dist/behavioural/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "import": "./dist/contracts/index.js"
    },
    "./virtual-time": {
      "types": "./dist/virtual-time/index.d.ts",
      "import": "./dist/virtual-time/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@obinexusltd/obix-spec": "0.2.1",
    "@obinexusltd/obix-ir": "0.2.1",
    "@obinexusltd/obix-validator": "0.2.1",
    "@obinexusltd/obix-adapter-data": "0.2.1",
    "@obinexusltd/obix-adapter-func": "0.2.1",
    "@obinexusltd/obix-adapter-oop": "0.2.1",
    "@obinexusltd/obix-adapter-reactive": "0.2.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/obinexusmk2/obix-monorepo-2026.git",
    "directory": "packages/obix-test"
  }
