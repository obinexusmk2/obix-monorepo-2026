{
  "name": "@obinexusltd/obix-game-pong",
  "version": "0.3.0",
  "description": "OBIX Pong — a neon-styled Pong built as a Data-Oriented component (state/actions/render/mount fully separated). Zero dependencies.",
  "license": "MIT",
  "author": "OBINexus Computing — Nnamdi Michael Okpala <okpalan@protonmail.com>",
  "type": "module",
  "private": false,
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./src": "./src/index.ts",
    "./assets/*": "./assets/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "dist",
    "docs",
    "test",
    "assets",
    "README.md",
    "LICENSE",
    "LICENSE-ASSETS.txt"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test \"test/*.test.mjs\""
  },
  "keywords": ["obix", "component", "game", "pong", "canvas", "accessibility", "data-oriented"],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/obinexusmk2/obix-monorepo-2026.git",
    "directory": "games/obix-game-pong"
  }
}
