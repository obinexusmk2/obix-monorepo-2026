# ─────────────────────────────────────────────────────────────
# dependencies
# ─────────────────────────────────────────────────────────────
node_modules/
.npm/
npm-debug.log*

# ─────────────────────────────────────────────────────────────
# python (scripts/*.py tooling)
# ─────────────────────────────────────────────────────────────
__pycache__/
*.pyc

# ─────────────────────────────────────────────────────────────
# build output
# ─────────────────────────────────────────────────────────────
packages/*/dist/
packages/*/*.tsbuildinfo
suite/**/dist/
suite/**/*.tsbuildinfo
adapters/*/dist/
adapters/*/*.tsbuildinfo
primitives/*/dist/
primitives/*/*.tsbuildinfo
overlays/obix-component-*/dist/
overlays/obix-component-*/*.tsbuildinfo
runtime/obix/dist/
runtime/obix/*.tsbuildinfo
games/*/dist/
games/*/*.tsbuildinfo
*.tsbuildinfo
.tsbuild/

# ─────────────────────────────────────────────────────────────
# test / tool scratch
# ─────────────────────────────────────────────────────────────
packages/*/test/__out__/
.obix-build/
coverage/
*.tgz

# ─────────────────────────────────────────────────────────────
# editor / os
# ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# ─────────────────────────────────────────────────────────────
# Pre-existing legacy checkout in this working tree.
# The OBIX 1.0 Level 0 monorepo is packages/ + scripts/ + docs/ + root config.
# The category folders below are an earlier, unrelated layout kept on disk for
# reference; they are their own (sometimes embedded) git checkouts and are NOT
# part of this repository. Do not delete them — just don't track them here.
# ─────────────────────────────────────────────────────────────
/bindings/
/cli/
/components/
/configs/
/controls/
/data/
/demos/
/drivers/
/feedback/
/forms/
/navigation/
/overlays/obix-component-overlays/
/runtime/
/fixtures/
/obix-monorepo/
